<!DOCTYPE html>
<html>
<head>
<title>EagleCraft</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  background: #111;
  overflow: hidden;
  font-family: Arial;
}
#game {
  width: 100vw;
  height: calc(100vh - 42px);
  border: none;
  display: block;
}
#controls {
  height: 42px;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 5px 12px;
  background: #222;
}
button {
  background: #398348;
  color: white;
  border: none;
  padding: 8px 18px;
  border-radius: 5px;
  cursor: pointer;
}
</style>
</head>
<body>

<iframe id="game"
src="YOUR_EAGLECRAFT_LINK"
allow="fullscreen; autoplay; gamepad"
allowfullscreen>
</iframe>

<div id="controls">
<button onclick="toggleFullscreen()">FULLSCREEN</button>
</div>

<script>
function toggleFullscreen() {
  const game = document.getElementById("game");

  if (!document.fullscreenElement) {
    game.requestFullscreen();
  } else {
    document.exitFullscreen();
  }
}
</script>

</body>
</html>
